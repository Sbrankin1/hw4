# Copy to .env and adjust if your database lives somewhere else.
# Default: <AI Foundations>/Data 3/campus_customs.db
CAMPUS_DB_PATH=../../../Data 3/campus_customs.db

# Secret used to sign login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left unset, a random key is generated at startup (logins reset on restart).
SECRET_KEY=

# ── Chatbot agent (Pydantic AI over a Portkey-served model) ──────────
# The same gateway credentials used elsewhere in this course.
PORTKEY_API_KEY=your-portkey-key-here
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
